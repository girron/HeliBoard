<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Soft black drop shadow, 1dp raised edge. -->
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="11dp" />
            <solid android:color="#000000" />
        </shape>
    </item>
    <!-- Silver bevel, brightest at the top of the key. -->
    <item android:left="1dp" android:right="1dp" android:top="0dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <gradient android:angle="270"
                android:startColor="#CBD0D3" android:centerColor="#666B70"
                android:endColor="#373A3D" />
            <stroke android:width="0.7dp" android:color="#979DA2" />
        </shape>
    </item>
    <!-- Inner charcoal glass surface: top shine fades to near-black. -->
    <item android:left="3dp" android:right="3dp" android:top="2dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <gradient android:angle="270"
                android:startColor="#626262" android:centerColor="#292929"
                android:endColor="#101010" />
            <stroke android:width="0.5dp" android:color="#262626" />
        </shape>
    </item>
</layer-list>
